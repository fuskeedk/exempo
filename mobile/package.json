{
  "name": "exempo-app",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --web --offline --clear",
    "start:go": "expo start --lan --offline --clear",
    "start:tunnel": "expo start --tunnel --clear",
    "export:web": "expo export --platform web --output-dir dist",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "prebuild": "expo prebuild",
    "build:ios": "eas build --platform ios --profile production"
  },
  "dependencies": {
    "expo": "^57.0.25",
    "expo-camera": "~57.0.5",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
